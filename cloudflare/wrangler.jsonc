{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "illusion-messenger",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../build/cloud-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/v1/*", "/health", "/policies/*", "/admin/*", "/telegram/*"]
  },
  "durable_objects": {"bindings": [{"name": "RELAY", "class_name": "IllusionRelay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["IllusionRelay"]}],
  "ratelimits": [
    {"name":"AUTH_LIMIT","namespace_id":"7606001","simple":{"limit":15,"period":60}},
    {"name":"API_LIMIT","namespace_id":"7606003","simple":{"limit":1200,"period":60}},
    {"name":"LIVE_LIMIT","namespace_id":"7606002","simple":{"limit":30,"period":60}},
    {"name":"ADMIN_LIMIT","namespace_id":"7606004","simple":{"limit":30,"period":60}}
  ],
  "observability": {"enabled": false},
  "vars": {"OPERATOR_NAME": "", "OPERATOR_COUNTRY": "", "SUPPORT_CONTACT": "", "OPERATOR_ADDRESS": ""}
}
