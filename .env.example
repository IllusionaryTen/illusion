# Keep this file's real values in .env, never inside the desktop app.
HOST=127.0.0.1
PORT=3789
DATA_DIR=./data
# To expose beyond your PC, use HTTPS or configure these certificate files.
# TLS_CERT=./certs/server.crt
# TLS_KEY=./certs/server.key
# Optional: require this code to create an account.
REGISTRATION_CODE=
# Create a bot with @BotFather in Telegram, then paste its token here.
TELEGRAM_BOT_TOKEN=
RELEASE_MANIFEST=./dist/release.json
# Optional public HTTPS relay embedded into the Windows build. No bot token is embedded.
DEFAULT_RELAY_URL=
DEFAULT_NETWORK_NAME=Illusion
# Optional tunnel transport: auto (default), quic or http2. No TLS checks are disabled.
PUBLIC_TUNNEL_PROTOCOL=auto
# Public operator details for policy notices. Leave private information out.
OPERATOR_NAME=
OPERATOR_COUNTRY=
SUPPORT_CONTACT=
OPERATOR_ADDRESS=
